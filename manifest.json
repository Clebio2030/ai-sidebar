{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "version": "1.2.2",
  "author": "AI Sidebar",
  "default_locale": "en",
  "action": {
    "default_title": "Click to Open AI Sidebar",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon.png"
  },
  "permissions": [
    "sidePanel",
    "declarativeNetRequest",
    "storage",
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.chatgpt.com/*",
    "https://*.claude.ai/*",
    "https://gemini.google.com/*",
    "https://*.google.com/*",
    "https://*.grok.com/*",
    "https://*.copilot.microsoft.com/*",
    "https://*.microsoft.com/*",
    "https://*.meta.ai/*",
    "https://*.deepseek.com/*",
    "https://*.mistral.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.meta.ai/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
